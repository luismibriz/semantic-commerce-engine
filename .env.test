# The unit and application test suites run without a kernel, database or
# Elasticsearch: they exercise the domain and use cases against in-memory
# test doubles. These values exist only so the framework can boot if needed.
APP_ENV=test
APP_DEBUG=0
APP_SECRET=test-secret
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app_test?serverVersion=16&charset=utf8"
SEARCH_BACKEND=elasticsearch
ELASTICSEARCH_DSN=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=products_test
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
