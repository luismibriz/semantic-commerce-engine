# Default environment values. Override locally in .env.local (git-ignored).
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=2f9c1a7b4e6d8f0a3c5b7e9d1f2a4c6e

# Relational store — source of truth for the Product write model.
DATABASE_URL="postgresql://app:app@database:5432/app?serverVersion=16&charset=utf8"

# Vector-search backend that powers the read model:
#  - elasticsearch: dense_vector + kNN (default).
#  - pgvector:      a vector(N) column in PostgreSQL with an HNSW index.
# Both implement the same domain ports; switching one value is enough.
SEARCH_BACKEND=elasticsearch

# Elasticsearch — used when SEARCH_BACKEND=elasticsearch.
ELASTICSEARCH_DSN=http://elasticsearch:9200
ELASTICSEARCH_INDEX=products

# Embedding model.
#  - hashing: offline, deterministic, no API key (default; lets the stack boot anywhere).
#  - openai:  real semantic embeddings; requires OPENAI_API_KEY.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
